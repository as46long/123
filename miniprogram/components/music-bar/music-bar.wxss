.music-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(180deg, rgba(13,13,26,0.96) 0%, rgba(13,13,26,0.99) 100%);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  z-index: 1000;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.4);
}

.music-bar.show {
  transform: translateY(0);
}

/* 进度条 */
.progress-line {
  height: 2rpx;
  background: rgba(255, 255, 255, 0.06);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #F472B6, #8B5CF6);
  transition: width 0.3s ease;
  box-shadow: 0 0 8rpx rgba(244, 114, 182, 0.4);
}

/* 内容区域 */
.bar-content {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

/* 封面 - 旋转动画 */
.cover-wrapper {
  width: 88rpx;
  height: 88rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  border-radius: 50%;
  overflow: hidden;
}

.cover {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.4);
}

.cover.rotating {
  animation: rotate 20s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 歌曲信息 */
.song-info {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.song-title {
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.95);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.song-artist {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 6rpx;
}

/* 控制按钮 */
.controls {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}

.control-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  border-radius: 50%;
  transition: all 0.2s ease;
}

.control-btn:active {
  background: rgba(255, 255, 255, 0.08);
  transform: scale(0.92);
}

/* 图标 */
.icon-play::before {
  content: '▶';
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-left: 4rpx;
}

.icon-pause::before {
  content: '⏸';
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
}

.icon-next-bar::before {
  content: '⏭';
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.85);
}
