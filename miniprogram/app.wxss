/* 全局样式 */
page {
  background-color: #1a1a2e;
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
}

.container {
  padding: 20rpx;
}

.card {
  background: linear-gradient(145deg, #252542, #1e1e36);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.primary-btn {
  background: linear-gradient(135deg, #6B5B95, #FF6B9D);
  color: #fff;
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  border: none;
}

.vip-tag {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: #000;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.song-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.song-cover {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.song-info {
  flex: 1;
}

.song-title {
  font-size: 28rpx;
  color: #fff;
  margin-bottom: 8rpx;
}

.song-artist {
  font-size: 24rpx;
  color: #999;
}
