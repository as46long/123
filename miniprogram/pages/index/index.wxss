.container {
  padding: 20rpx;
  padding-bottom: 120rpx;
}

.search-bar {
  background: rgba(255,255,255,0.1);
  border-radius: 40rpx;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.search-icon {
  margin-right: 20rpx;
}

.search-placeholder {
  color: #999;
  font-size: 28rpx;
}

.categories {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.category-item {
  background: linear-gradient(135deg, #6B5B95, #FF6B9D);
  padding: 16rpx 32rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #fff;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.play-all {
  font-size: 24rpx;
  color: #FF6B9D;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
}

.play-icon {
  color: #FF6B9D;
  font-size: 32rpx;
}
