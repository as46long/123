<view class="playlist-page {{showMusicBar ? 'has-music-bar' : ''}}">
  <!-- 标签切换 -->
  <view class="tabs">
    <view class="tab {{currentTab === index ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="*this" data-index="{{index}}" bindtap="switchTab">
      {{item}}
      <text wx:if="{{index === 0 && !isLoggedIn}}" class="lock-icon">🔒</text>
    </view>
  </view>

  <!-- 未登录提示 -->
  <view wx:if="{{currentTab === 0 && !isLoggedIn}}" class="login-tip">
    <text>请先登录查看收藏</text>
    <button class="login-btn" bindtap="goToLogin">去登录</button>
  </view>

  <!-- 播放全部 -->
  <view class="play-all" bindtap="onPlayAll" wx:if="{{currentList.length > 0}}">
    <text>▶ 播放全部</text>
  </view>

  <!-- 歌曲列表 -->
  <view wx:if="{{loading}}" class="loading">加载中...</view>
  <view wx:elif="{{currentTab === 0 && !isLoggedIn}}"></view>
  <view wx:else class="song-list">
    <view class="song-item" wx:for="{{currentList}}" wx:key="id" data-song="{{item}}" bindtap="onSongTap">
      <image class="song-cover" src="{{item.coverUrl || '/static/images/default-cover.png'}}" mode="aspectFill" />
      <view class="song-info">
        <view class="song-title">{{item.title}} <text wx:if="{{item.isVip}}" class="vip-tag">VIP</text></view>
        <view class="song-artist">{{item.artist}}</view>
      </view>
      <text class="play-icon">▶</text>
    </view>
    <view wx:if="{{currentList.length === 0}}" class="empty">
      暂无内容
    </view>
  </view>
</view>

<!-- 底部播放条 -->
<music-bar show="{{showMusicBar}}" />
