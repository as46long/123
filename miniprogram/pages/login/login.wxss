.login-page {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
  background: linear-gradient(180deg, #0D0D1A 0%, #1A0A1E 100%);
}

.login-box {
  width: 100%;
  padding: 64rpx 40rpx;
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.4);
}

.logo {
  font-size: 80rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 600;
  text-align: center;
  color: rgba(255, 255, 255, 0.95);
  margin-bottom: 64rpx;
  letter-spacing: 2rpx;
}

.form {
  width: 100%;
}

.input {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 48rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  color: rgba(255, 255, 255, 0.95);
  font-size: 28rpx;
  transition: all 0.2s ease;
}

.input:focus {
  border-color: rgba(244, 114, 182, 0.4);
  background: rgba(255, 255, 255, 0.08);
}

.submit-btn {
  width: 100%;
  margin-top: 20rpx;
  background: linear-gradient(135deg, #F472B6, #8B5CF6);
  color: #fff;
  border-radius: 48rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(244, 114, 182, 0.3);
  transition: all 0.3s ease;
}

.submit-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(244, 114, 182, 0.2);
}

.divider {
  display: flex;
  align-items: center;
  margin: 48rpx 0 32rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.1);
}

.divider-text {
  padding: 0 20rpx;
  color: rgba(255, 255, 255, 0.35);
  font-size: 24rpx;
}

.wx-login-btn {
  width: 100%;
  background: #07C160;
  color: #fff;
  border-radius: 48rpx;
  padding: 24rpx;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  font-size: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
  transition: all 0.2s ease;
}

.wx-login-btn:active {
  transform: scale(0.98);
}

.wx-icon {
  margin-right: 10rpx;
  font-size: 32rpx;
}

.wx-text {
  font-size: 28rpx;
}

.switch-mode {
  text-align: center;
  color: #F472B6;
  margin-top: 32rpx;
  font-size: 26rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
}

.modal-content {
  width: 80%;
  background: rgba(26, 26, 46, 0.95);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 40rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.5);
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
  text-align: center;
  margin-bottom: 16rpx;
}

.modal-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  text-align: center;
  margin-bottom: 48rpx;
}

.avatar-section {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
}

.avatar-btn {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.avatar-text {
  font-size: 24rpx;
  color: #F472B6;
  margin-top: 16rpx;
}

.nickname-section {
  margin-bottom: 32rpx;
}

.nickname-input {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 48rpx;
  padding: 24rpx 32rpx;
  color: rgba(255, 255, 255, 0.95);
  font-size: 28rpx;
  text-align: center;
}

.confirm-btn {
  width: 100%;
  background: linear-gradient(135deg, #F472B6, #8B5CF6);
  color: #fff;
  border-radius: 48rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(244, 114, 182, 0.3);
  transition: all 0.2s ease;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn:active {
  transform: scale(0.98);
}
