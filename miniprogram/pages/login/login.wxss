.login-page {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
}

.login-box {
  width: 100%;
  padding: 60rpx 40rpx;
  background: linear-gradient(145deg, #252542, #1e1e36);
  border-radius: 24rpx;
}

.logo {
  font-size: 80rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  text-align: center;
  color: #fff;
  margin-bottom: 60rpx;
}

.form {
  width: 100%;
}

.input {
  background: rgba(255,255,255,0.1);
  border-radius: 40rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
  font-size: 28rpx;
}

.submit-btn {
  width: 100%;
  margin-top: 20rpx;
}

.wx-btn {
  width: 100%;
  background: #07C160;
  color: #fff;
  border-radius: 40rpx;
  padding: 24rpx;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.wx-icon {
  margin-right: 10rpx;
}

.switch-mode {
  text-align: center;
  color: #FF6B9D;
  margin-top: 30rpx;
  font-size: 26rpx;
}
