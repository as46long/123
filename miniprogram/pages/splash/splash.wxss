.splash-page {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  background: #0D0D1A;
  display: flex;
  justify-content: center;
  align-items: center;
}

.splash-image {
  width: 100%;
  height: 100%;
}

.click-hint {
  position: absolute;
  bottom: 100rpx;
  left: 50%;
  transform: translateX(-50%);
  color: rgba(255, 255, 255, 0.85);
  font-size: 28rpx;
  padding: 20rpx 48rpx;
  background: rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 48rpx;
}

.loading {
  color: rgba(255, 255, 255, 0.6);
  font-size: 32rpx;
}
