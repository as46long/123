.search-page {
  padding: 20rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.1);
  border-radius: 40rpx;
  padding: 10rpx 20rpx;
  margin-bottom: 30rpx;
}

.search-input {
  flex: 1;
  color: #fff;
  font-size: 28rpx;
}

.clear-btn {
  color: #999;
  font-size: 32rpx;
  padding: 0 20rpx;
}

.search-btn {
  color: #FF6B9D;
  font-size: 28rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}

.clear-history {
  font-size: 24rpx;
  color: #999;
}

.history-tags, .hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-tag, .hot-tag {
  background: rgba(255,255,255,0.1);
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #fff;
}

.hot-tag {
  background: linear-gradient(135deg, rgba(107,91,149,0.5), rgba(255,107,157,0.5));
}

.results {
  padding-bottom: 20rpx;
}
