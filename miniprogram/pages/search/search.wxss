.search-page {
  padding: 24rpx;
}

/* 搜索栏 - 玻璃拟态 */
.search-bar {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 48rpx;
  padding: 12rpx 24rpx;
  margin-bottom: 32rpx;
  transition: all 0.3s ease;
}

.search-bar:focus-within {
  border-color: rgba(244, 114, 182, 0.4);
  background: rgba(255, 255, 255, 0.08);
}

.search-input {
  flex: 1;
  color: rgba(255, 255, 255, 0.95);
  font-size: 28rpx;
}

.clear-btn {
  color: rgba(255, 255, 255, 0.4);
  font-size: 32rpx;
  padding: 0 16rpx;
}

.search-btn {
  color: #F472B6;
  font-size: 28rpx;
  padding: 0 16rpx;
  font-weight: 500;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}

.clear-history {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  padding: 8rpx 16rpx;
  border-radius: 32rpx;
  transition: all 0.2s ease;
}

.clear-history:active {
  background: rgba(255, 255, 255, 0.06);
}

/* 标签 - 玻璃拟态 */
.history-tags, .hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-tag {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  padding: 12rpx 24rpx;
  border-radius: 48rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  transition: all 0.2s ease;
}

.history-tag:active {
  background: rgba(255, 255, 255, 0.1);
}

.hot-tag {
  background: linear-gradient(135deg, rgba(244, 114, 182, 0.15), rgba(139, 92, 246, 0.15));
  border: 1rpx solid rgba(244, 114, 182, 0.2);
  color: rgba(255, 255, 255, 0.85);
}

.hot-tag:active {
  background: linear-gradient(135deg, rgba(244, 114, 182, 0.25), rgba(139, 92, 246, 0.25));
}

.results {
  padding-bottom: 20rpx;
}

.play-all {
  color: #F472B6;
  font-size: 26rpx;
  padding: 10rpx 28rpx;
  border: 1rpx solid rgba(244, 114, 182, 0.4);
  border-radius: 48rpx;
  background: rgba(244, 114, 182, 0.08);
  transition: all 0.2s ease;
}

.play-all:active {
  background: rgba(244, 114, 182, 0.15);
}
