<view class="profile-page">
  <view class="user-card" wx:if="{{userInfo}}">
    <image class="avatar" src="{{userInfo.avatar || '/static/images/default-avatar.png'}}" mode="aspectFill" />
    <view class="user-info">
      <view class="nickname">{{userInfo.nickname || userInfo.username}}</view>
      <view class="vip-status">
        <text wx:if="{{isVip}}" class="vip-tag">👑 VIP会员</text>
        <text wx:else class="normal-tag">普通用户</text>
      </view>
    </view>
  </view>

  <view wx:else class="login-prompt">
    <view class="prompt-text">登录后享受更多功能</view>
    <button class="primary-btn" bindtap="onLoginTap">立即登录</button>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="onPlaylistTap">
      <text class="menu-icon">❤️</text>
      <text class="menu-text">我的收藏</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onVipTap">
      <text class="menu-icon">👑</text>
      <text class="menu-text">会员中心</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onOrderTap">
      <text class="menu-icon">📋</text>
      <text class="menu-text">订单记录</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <button wx:if="{{userInfo}}" class="logout-btn" bindtap="onLogout">退出登录</button>
</view>
