/* ==========================================
   个人中心 - 重构版
   ========================================== */

.profile-page {
  padding: 24rpx;
  padding-bottom: 48rpx;
  min-height: 100vh;
}

.profile-page.has-music-bar {
  padding-bottom: 180rpx;
}

/* ==========================================
   用户卡片
   ========================================== */
.user-card {
  position: relative;
  border-radius: 40rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.4);
}

.user-card-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #1A1A2E 0%, #2D1B4E 50%, #1A1A2E 100%);
}

.user-card.is-vip .user-card-bg {
  background: linear-gradient(135deg, #2D1B00 0%, #4A2E00 50%, #2D1B00 100%);
}

.user-card-content {
  position: relative;
  display: flex;
  align-items: center;
  padding: 40rpx;
  z-index: 1;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  margin-right: 32rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.15);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.nickname-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.nickname {
  font-size: 38rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.95);
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vip-badge {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  background: linear-gradient(135deg, #FBBF24, #F59E0B);
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(251, 191, 36, 0.3);
  flex-shrink: 0;
}

.vip-icon {
  font-size: 20rpx;
}

.vip-text {
  font-size: 22rpx;
  color: #000;
  font-weight: 600;
}

.user-desc {
  font-size: 24rpx;
}

.expire-text {
  color: rgba(255, 255, 255, 0.5);
}

.upgrade-text {
  color: #F472B6;
}

.edit-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.edit-btn:active {
  background: rgba(255, 255, 255, 0.15);
  transform: scale(0.92);
}

.icon-edit::before {
  content: '✏️';
  font-size: 32rpx;
}

/* ==========================================
   登录提示卡片
   ========================================== */
.login-prompt-card {
  background: rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 40rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

.login-prompt-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.prompt-text {
  color: rgba(255, 255, 255, 0.5);
  font-size: 28rpx;
  margin-bottom: 40rpx;
}

.login-btn {
  background: linear-gradient(135deg, #F472B6, #8B5CF6);
  color: #fff;
  border-radius: 48rpx;
  padding: 24rpx 64rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(244, 114, 182, 0.3);
  transition: all 0.3s ease;
}

.login-btn:active {
  transform: scale(0.96);
}

/* ==========================================
   统计卡片
   ========================================== */
.stats-card {
  background: rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 32rpx;
  padding: 32rpx 0;
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx;
  transition: all 0.2s ease;
}

.stat-item:active {
  background: rgba(255, 255, 255, 0.04);
  border-radius: 24rpx;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.95);
  font-variant-numeric: tabular-nums;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.08);
}

/* ==========================================
   菜单区域
   ========================================== */
.menu-section {
  margin-bottom: 40rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  letter-spacing: 1rpx;
}

.menu-card {
  background: rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
  transition: background 0.2s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: rgba(255, 255, 255, 0.04);
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon-wrapper {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-icon-pink {
  background: rgba(244, 114, 182, 0.15);
}

.menu-icon-blue {
  background: rgba(59, 130, 246, 0.15);
}

.menu-icon-gold {
  background: rgba(251, 191, 36, 0.15);
}

.menu-icon-green {
  background: rgba(16, 185, 129, 0.15);
}

.menu-icon {
  font-size: 32rpx;
}

.menu-text {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.menu-extra {
  font-size: 24rpx;
  color: rgba(251, 191, 36, 0.8);
  font-weight: 500;
}

.icon-arrow::before {
  content: '›';
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.3);
}

/* ==========================================
   退出按钮
   ========================================== */
.logout-btn {
  margin-top: 48rpx;
  background: rgba(239, 68, 68, 0.1);
  border: 1rpx solid rgba(239, 68, 68, 0.15);
  color: #F87171;
  border-radius: 48rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.logout-btn:active {
  background: rgba(239, 68, 68, 0.15);
  transform: scale(0.98);
}
