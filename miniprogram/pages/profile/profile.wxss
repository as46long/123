.profile-page {
  padding: 40rpx;
}

.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(145deg, #252542, #1e1e36);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 30rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.vip-tag {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: #000;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.normal-tag {
  color: #999;
  font-size: 24rpx;
}

.login-prompt {
  text-align: center;
  padding: 60rpx 0;
}

.prompt-text {
  color: #999;
  margin-bottom: 30rpx;
}

.menu-list {
  background: linear-gradient(145deg, #252542, #1e1e36);
  border-radius: 24rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #fff;
}

.arrow {
  color: #999;
  font-size: 32rpx;
}

.logout-btn {
  margin-top: 60rpx;
  background: rgba(255,107,157,0.2);
  color: #FF6B9D;
  border-radius: 40rpx;
  padding: 24rpx;
  border: none;
}
