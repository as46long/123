.edit-profile-page {
  padding: 40rpx;
  background: linear-gradient(180deg, #0D0D1A 0%, #1A0A1E 100%);
  min-height: 100vh;
}

.form-card {
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 40rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
  margin-bottom: 48rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.06);
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(244, 114, 182, 0.3);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.4);
}

.avatar-tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #F472B6;
}

.form-item {
  margin-bottom: 48rpx;
}

.label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 16rpx;
}

.input {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.95);
  transition: all 0.2s ease;
}

.input:focus {
  border-color: rgba(244, 114, 182, 0.4);
}

.save-btn {
  margin-top: 64rpx;
  background: linear-gradient(135deg, #F472B6, #8B5CF6);
  color: #fff;
  border-radius: 48rpx;
  padding: 24rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(244, 114, 182, 0.3);
  transition: all 0.3s ease;
}

.save-btn:active {
  transform: scale(0.98);
}
