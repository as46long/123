<view class="edit-profile-page">
  <view class="form-card">
    <view class="avatar-section" bindtap="onChooseAvatar">
      <image class="avatar" src="{{tempAvatarPath || userInfo.avatar || '/static/images/default-avatar.png'}}" mode="aspectFill" />
      <view class="avatar-tip">点击更换头像</view>
    </view>

    <view class="form-item">
      <view class="label">昵称</view>
      <input class="input" 
             placeholder="请输入昵称" 
             value="{{userInfo.nickname}}" 
             data-field="nickname"
             bindinput="onInputChange" />
    </view>

    <view class="form-item">
      <view class="label">手机号</view>
      <input class="input" 
             placeholder="请输入手机号" 
             value="{{userInfo.phone}}" 
             data-field="phone"
             bindinput="onInputChange"
             type="number" />
    </view>

    <view class="form-item">
      <view class="label">邮箱</view>
      <input class="input" 
             placeholder="请输入邮箱" 
             value="{{userInfo.email}}" 
             data-field="email"
             bindinput="onInputChange"
             type="text" />
    </view>
  </view>

  <button class="save-btn" bindtap="onSave">保存修改</button>
</view>
