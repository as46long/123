.vip-page {
  padding: 24rpx;
  padding-bottom: 120rpx;
}

/* 用户卡片 - 金色渐变 */
.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FBBF24, #F59E0B);
  border-radius: 40rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(251, 191, 36, 0.3);
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 3rpx solid rgba(255,255,255,0.4);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.2);
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 34rpx;
  font-weight: 600;
  color: #000;
  margin-bottom: 12rpx;
}

.vip-status {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.vip-badge {
  font-size: 26rpx;
  color: #78350F;
  font-weight: 600;
}

.expire-time {
  font-size: 24rpx;
  color: rgba(0,0,0,0.6);
}

.normal-text {
  font-size: 24rpx;
  color: rgba(0,0,0,0.6);
}

/* 套餐卡片 - 玻璃拟态 */
.packages {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 48rpx;
}

.package {
  width: calc(50% - 10rpx);
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 32rpx;
  padding: 32rpx 20rpx;
  text-align: center;
  position: relative;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.package:active {
  transform: scale(0.98);
}

.package.active {
  border-color: #F472B6;
  background: rgba(244, 114, 182, 0.08);
  box-shadow: 0 4rpx 16rpx rgba(244, 114, 182, 0.2);
}

.package.recommend {
  background: rgba(139, 92, 246, 0.08);
  border-color: rgba(139, 92, 246, 0.3);
}

.recommend-tag {
  position: absolute;
  top: -12rpx;
  right: 16rpx;
  background: linear-gradient(135deg, #F472B6, #8B5CF6);
  color: #fff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(244, 114, 182, 0.3);
}

.package-name {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.package-price {
  font-size: 44rpx;
  font-weight: 600;
  color: #F472B6;
  margin-bottom: 12rpx;
}

.package-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}

/* 权益列表 - 玻璃拟态 */
.benefits {
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 48rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.benefit-item {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 16rpx;
  padding-left: 24rpx;
  position: relative;
}

.benefit-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #F472B6;
}

.benefit-item:last-child {
  margin-bottom: 0;
}

.pay-btn {
  position: fixed;
  bottom: 40rpx;
  left: 40rpx;
  right: 40rpx;
  background: linear-gradient(135deg, #F472B6, #8B5CF6);
  color: #fff;
  border-radius: 48rpx;
  padding: 24rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(244, 114, 182, 0.3);
  transition: all 0.3s ease;
}

.pay-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(244, 114, 182, 0.2);
}
