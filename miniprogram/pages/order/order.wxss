.order-page {
  padding: 20rpx;
}

.loading, .empty {
  text-align: center;
  padding: 60rpx;
  color: #999;
}

.order-item {
  background: linear-gradient(145deg, #252542, #1e1e36);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.order-status {
  font-size: 24rpx;
  color: #999;
}

.order-status.paid {
  color: #67C23A;
}

.order-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.package-name {
  font-size: 32rpx;
  color: #fff;
}

.order-amount {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF6B9D;
}

.order-footer {
  font-size: 24rpx;
  color: #666;
}
