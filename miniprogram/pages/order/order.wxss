.order-page {
  padding: 24rpx;
}

.loading, .empty {
  text-align: center;
  padding: 80rpx;
  color: rgba(255, 255, 255, 0.3);
}

/* 订单卡片 - 玻璃拟态 */
.order-item {
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 32rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.order-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.order-no {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.35);
}

.order-status {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.order-status.paid {
  color: #34D399;
}

.order-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.package-name {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.order-amount {
  font-size: 36rpx;
  font-weight: 600;
  color: #F472B6;
}

.order-footer {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.35);
}
