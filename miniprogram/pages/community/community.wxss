.community-page {
  padding: 24rpx;
  padding-bottom: 48rpx;
}

.community-page.has-music-bar {
  padding-bottom: 180rpx;
}

/* 发布框 - 玻璃拟态 */
.post-box {
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 32rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.input {
  width: 100%;
  height: 160rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 20rpx;
  padding: 16rpx;
}

.post-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
}

.char-count {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.35);
}

.submit-btn {
  padding: 16rpx 40rpx;
  font-size: 26rpx;
  background: linear-gradient(135deg, #F472B6, #8B5CF6);
  color: #fff;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(244, 114, 182, 0.3);
  transition: all 0.2s ease;
}

.submit-btn:active {
  transform: scale(0.96);
}

.loading, .empty {
  text-align: center;
  padding: 80rpx;
  color: rgba(255, 255, 255, 0.3);
}

/* 评论卡片 - 玻璃拟态 */
.comment-item {
  display: flex;
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 32rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  transition: all 0.2s ease;
}

.comment-item:active {
  background: rgba(255, 255, 255, 0.05);
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.comment-content {
  flex: 1;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.username {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.time {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.35);
}

.comment-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.like-btn {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 32rpx;
  transition: all 0.2s ease;
}

.like-btn:active {
  background: rgba(244, 114, 182, 0.15);
  color: #F472B6;
}
