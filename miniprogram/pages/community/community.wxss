.community-page {
  padding: 20rpx;
}

.post-box {
  background: linear-gradient(145deg, #252542, #1e1e36);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.input {
  width: 100%;
  height: 150rpx;
  color: #fff;
  font-size: 28rpx;
}

.post-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.char-count {
  font-size: 24rpx;
  color: #999;
}

.submit-btn {
  padding: 16rpx 40rpx;
  font-size: 26rpx;
}

.loading, .empty {
  text-align: center;
  padding: 60rpx;
  color: #999;
}

.comment-item {
  display: flex;
  background: linear-gradient(145deg, #252542, #1e1e36);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.comment-content {
  flex: 1;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.username {
  font-size: 28rpx;
  color: #fff;
}

.time {
  font-size: 24rpx;
  color: #666;
}

.comment-text {
  font-size: 28rpx;
  color: #ccc;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.like-btn {
  font-size: 24rpx;
  color: #999;
}
