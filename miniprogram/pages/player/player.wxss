.player-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  position: relative;
  overflow: hidden;
}

.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  filter: blur(60px);
  opacity: 0.6;
  z-index: -1;
}

.bg-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.4);
  z-index: -1;
}

.song-info {
  text-align: center;
  margin-bottom: 40rpx;
}

.cover {
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  margin-bottom: 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.3);
}

.cover.rotating {
  animation: rotate 20s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.artist {
  font-size: 28rpx;
  color: rgba(255,255,255,0.7);
}

.lyrics-container {
  flex: 1;
  width: 100%;
  text-align: center;
}

.lyric-item {
  padding: 10rpx 0;
  font-size: 28rpx;
  color: rgba(255,255,255,0.5);
  transition: all 0.3s;
}

.lyric-item.active {
  font-size: 32rpx;
  color: #FF6B9D;
}

.progress {
  width: 100%;
  display: flex;
  align-items: center;
  margin: 30rpx 0;
}

.time {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  width: 80rpx;
}

.slider {
  flex: 1;
}

.controls {
  display: flex;
  justify-content: space-around;
  align-items: center;
  width: 100%;
  padding: 20rpx 0;
}

.control-btn {
  font-size: 48rpx;
  padding: 20rpx;
}

.play-btn {
  width: 100rpx;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  background: linear-gradient(135deg, #6B5B95, #FF6B9D);
  border-radius: 50%;
  font-size: 40rpx;
}

.control-btn.active {
  color: #FF6B9D;
}
